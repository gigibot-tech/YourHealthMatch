# Agora Configuration (required on Netlify: Site settings → Environment variables)
AGORA_APP_ID=your_agora_app_id_here
AGORA_APP_CERTIFICATE=your_agora_certificate_here

# Backend API (local Docker / Node only — unused on Netlify web client)
API_BASE_URL=https://api.yourapp.com
API_TIMEOUT=30000

# Environment
NODE_ENV=development

# Feature Flags
ENABLE_RECORDING=false
ENABLE_SCREEN_SHARE=false
ENABLE_CHAT=true
ENABLE_WAITING_ROOM=true

# Performance
MAX_VIDEO_BITRATE=1200
MAX_AUDIO_BITRATE=128
VIDEO_RESOLUTION=720p

# Logging
LOG_LEVEL=debug
ENABLE_ANALYTICS=false

# Security
TOKEN_EXPIRY_SECONDS=3600
ENABLE_ENCRYPTION=true
