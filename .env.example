# Remote API origin when the SPA is not served from Netlify (packaged Tauri).
# Vite/Netlify leave this empty and use same-origin /api.
VITE_API_BASE=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Verified sender, for example YourHealthMatch <hello@yourhealthmatch.de>
RESEND_API_KEY=
RESEND_FROM=
